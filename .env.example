# Copy to .env and fill in. .env is gitignored.

# --- WellnessLiving ---
WELLNESSLIVING_EMAIL=
WELLNESSLIVING_PASSWORD=

# --- Google Drive backup ---
# Drive for Desktop folder that each business's drive_folder (businesses.json)
# is relative to. Leave empty to turn backup off.
DRIVE_ROOT=

# --- Browser / debugging ---
# Set to false to watch the browser and clear verification prompts by hand.
HEADLESS=true
SLOW_MO=0
LOG_LEVEL=INFO
